!.env.sample
!.env.template

# Supabase CLI local state (keep migrations/config/types tracked)
supabase/.temp/
supabase/.branches/
supabase/.profiles/

# Local SQLite databases (not versioned app assets)
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Tests, reports and analysis caches
coverage/
.nyc_output/
test-results/
playwright-report/
*.lcov
*.tsbuildinfo
.eslintcache
.stylelintcache
.cache/
.turbo/

# Debug logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
bun-debug.*

# IDEs / editors (keep shareable VS Code recommendations)
.idea/
.vscode/*
